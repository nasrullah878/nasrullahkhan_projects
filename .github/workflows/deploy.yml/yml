name: CI/CD Pipeline

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3

    - name: Set up Docker
      uses: docker/setup-buildx-action@v2

    - name: Login to Docker Hub
      run: echo "${{ secrets.DOCKER_PASSWORD }}" | docker login -u "${{ secrets.DOCKER_USERNAME }}" --password-stdin

    - name: Build and Push Docker Image
      run: |
        docker build -t yourusername/myapp:${{ github.sha }} .
        docker push yourusername/myapp:${{ github.sha }}

    - name: Deploy to Kubernetes (optional)
      run: |
        kubectl set image deployment/myapp-deployment myapp=yourusername/myapp:${{ github.sha }}
